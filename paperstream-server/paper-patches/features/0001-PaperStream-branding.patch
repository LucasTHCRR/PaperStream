     @Override
     public Component getVersionMessage() {
-        final Component updateMessage;
-        if (BUILD_INFO.buildNumber().isEmpty() && BUILD_INFO.gitCommit().isEmpty()) {
-            updateMessage = text("You are running a development version without access to version information", color(0xFF5300));
-        } else {
-            updateMessage = getUpdateStatusMessage();
-        }
+        // PaperStream start - no update checks against PaperMC services
+        final Component updateMessage = text("PaperStream " + BUILD_INFO.asString(io.papermc.paper.ServerBuildInfo.StringRepresentation.VERSION_SIMPLE)
+            + ", based on Paper. Not affiliated with PaperMC.", color(0x2BB3E0));
+        // PaperStream end - no update checks against PaperMC services
         final @Nullable Component history = this.getHistory();
 
         return history != null ? Component.textOfChildren(updateMessage, Component.newline(), history) : updateMessage;
     }
 
