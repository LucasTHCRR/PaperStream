From: LucasTHCRR <330454039+LucasTHCRR@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:39:18 +0100
Subject: [PATCH] Flat bedrock condition: no objects per block


diff --git a/src/main/java/io/papermc/paper/world/worldgen/OptionallyFlatBedrockCondition.java b/src/main/java/io/papermc/paper/world/worldgen/OptionallyFlatBedrockCondition.java
index bd4bad0bac1e7bb0040568174eabb71aa185bb19..fd1c295aad4644517d7533551c51e949c2bae812 100755
--- a/src/main/java/io/papermc/paper/world/worldgen/OptionallyFlatBedrockCondition.java
+++ b/src/main/java/io/papermc/paper/world/worldgen/OptionallyFlatBedrockCondition.java
@@ -67,8 +67,7 @@ public record OptionallyFlatBedrockCondition(Identifier randomName, VerticalAnch
                 }
 
                 final double probability = Mth.map(blockY, trueAtAndBelowY, falseAtAndAboveY, 1.0, 0.0);
-                final RandomSource random = randomFactory.at(this.context.blockX(), blockY, this.context.blockZ());
-                return random.nextFloat() < probability;
+                return randomFactory.paperstream$firstFloatAt(this.context.blockX(), blockY, this.context.blockZ()) < probability; // PaperStream - no objects per block
             }
         };
     }
