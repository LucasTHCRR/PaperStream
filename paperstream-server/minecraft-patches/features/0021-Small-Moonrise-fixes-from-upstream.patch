+
+    public boolean moonrise$isSpecialCollidingBlock();
 }
diff --git a/net/minecraft/world/level/block/state/BlockBehaviour.java b/net/minecraft/world/level/block/state/BlockBehaviour.java
index 7093613a09a79d7ffce34f1cb54ec2605c5af384..be0899762dc1762450b10703ebf638233139efc1 100755
--- a/net/minecraft/world/level/block/state/BlockBehaviour.java
+++ b/net/minecraft/world/level/block/state/BlockBehaviour.java
@@ -488,6 +488,17 @@ public abstract class BlockBehaviour implements FeatureElement {
         private boolean emptyCollisionShape;
         private boolean emptyConstantCollisionShape;
         private VoxelShape constantCollisionShape;
+        private boolean isSpecialCollidingBlock;
+
+        private static boolean isSpecialCollidingBlock(final net.minecraft.world.level.block.state.BlockBehaviour.BlockStateBase block) {
+            // note: cannot reference Blocks here, as Blocks#<clinit> initialises the state caches in parallel
+            return block.hasLargeCollisionShape() || block.getBlock() instanceof net.minecraft.world.level.block.piston.MovingPistonBlock;
+        }
+
+        @Override
+        public final boolean moonrise$isSpecialCollidingBlock() {
+            return this.isSpecialCollidingBlock;
+        }
 
         private static void initCaches(final VoxelShape shape, final boolean neighbours) {
             ((ca.spottedleaf.moonrise.patches.collisions.shape.CollisionVoxelShape)shape).moonrise$isFullBlock();
@@ -625,6 +636,7 @@ public abstract class BlockBehaviour implements FeatureElement {
             this.isConditionallyFullOpaque = this.canOcclude & this.useShapeForLightOcclusion;
             // Paper end - rewrite chunk system
             // Paper start - optimise collisions
+            this.isSpecialCollidingBlock = isSpecialCollidingBlock(this);
             if (this.cache != null) {
                 final VoxelShape collisionShape = this.cache.collisionShape;
                 if (this.isAir()) {
