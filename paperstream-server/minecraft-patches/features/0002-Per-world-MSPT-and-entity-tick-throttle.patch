From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucasthcr@users.noreply.codeberg.org>
Date: Tue, 13 Oct 2026 23:44:50 +0200
Subject: [PATCH] Per world MSPT and entity tick throttle


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 829f7685904fd741e00403647ae76d32275c34a3..76002854a338a447cae8c6b87345fdbdb666a194 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -320,6 +320,11 @@ public final class ActivationRange {
             }
         }
         // removed the original's dumb tick skipping for active entities
+        // PaperStream start - tick idle mobs far from players less often
+        if (isActive && !entity.isTemporarilyActive && !net.paperstream.entity.EntityTickThrottle.shouldTick(entity)) {
+            return false;
+        }
+        // PaperStream end - tick idle mobs far from players less often
         return isActive;
     }
 
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 879f53a64e3070aca5f6c58a0e200b62c3e51117..452fdd607fff12eb292559e02d1ff9f31b563f2a 100755
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1819,8 +1819,10 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             profiler.push(() -> level + " " + level.dimension().identifier());
             profiler.push("tick");
 
+            final long psTickStart = System.nanoTime(); // PaperStream - per world MSPT
             try {
                 level.tick(haveTime);
+                level.psTickTimes.record(System.nanoTime() - psTickStart); // PaperStream - per world MSPT
             } catch (Throwable t) {
                 CrashReport report = CrashReport.forThrowable(t, "Exception ticking world");
                 level.fillReportDetails(report);
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 9415a75893a81f3d312117377b03aa440479599b..0bed7673d0242c35a86c553a7f324f58f079cf32 100755
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -183,6 +183,7 @@ import org.jspecify.annotations.Nullable;
 import org.slf4j.Logger;
 
 public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGetter, ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel, ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevelReader, ca.spottedleaf.moonrise.patches.chunk_tick_iteration.ChunkTickServerLevel { // Paper - rewrite chunk system // Paper - chunk tick iteration
+    public final net.paperstream.world.WorldTickTimes psTickTimes = new net.paperstream.world.WorldTickTimes(); // PaperStream - per world MSPT
     public static final BlockPos END_SPAWN_POINT = new BlockPos(100, 50, 0);
     public static final IntProvider RAIN_DELAY = UniformInt.of(12000, 180000);
     public static final IntProvider RAIN_DURATION = UniformInt.of(12000, 24000);
diff --git a/net/minecraft/world/entity/Mob.java b/net/minecraft/world/entity/Mob.java
index 1b89e5909d810d9da528c3e6cc312ef93d1c9d84..c33d77694b38c18a231452793ee97188680d4ae5 100755
--- a/net/minecraft/world/entity/Mob.java
+++ b/net/minecraft/world/entity/Mob.java
@@ -105,6 +105,10 @@ import org.bukkit.event.entity.EntityUnleashEvent;
 // CraftBukkit end
 
 public abstract class Mob extends LivingEntity implements Targeting, EquipmentUser, Leashable {
+    // PaperStream start - entity tick throttle
+    public int psThrottleInterval = 1;
+    public int psThrottleRecheckTick;
+    // PaperStream end - entity tick throttle
     private static final EntityDataAccessor<Byte> DATA_MOB_FLAGS_ID = SynchedEntityData.defineId(Mob.class, EntityDataSerializers.BYTE);
     private static final int MOB_FLAG_NO_AI = 1;
     private static final int MOB_FLAG_LEFTHANDED = 2;
