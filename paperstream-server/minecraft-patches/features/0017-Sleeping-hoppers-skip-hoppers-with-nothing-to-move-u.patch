From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucas@empireblocks.de>
Date: Wed, 4 Nov 2026 01:09:23 +0100
Subject: [PATCH] Sleeping hoppers: skip hoppers with nothing to move until
 something nearby changes


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index a79d8d21eeb7e064b1d7787ea8d9dc2ee7e801e5..1be511d5de667105442677e019360cac7dadea7d 100755
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -4975,6 +4975,9 @@ public abstract class Entity
             if (fx != this.blockPosition.getX() || fy != this.blockPosition.getY() || fz != this.blockPosition.getZ()) {
                 this.blockPosition = new BlockPos(fx, fy, fz);
                 this.inBlockState = null;
+                if ((this instanceof net.minecraft.world.entity.item.ItemEntity || this instanceof net.minecraft.world.entity.vehicle.ContainerEntity) && net.paperstream.world.HopperSleep.enabled()) {
+                    net.paperstream.world.HopperSleep.entityMoved(this.level, this.blockPosition); // PaperStream - Hopper wecken
+                }
                 if (SectionPos.blockToSectionCoord(fx) != this.chunkPosition.x() || SectionPos.blockToSectionCoord(fz) != this.chunkPosition.z()) {
                     this.chunkPosition = ChunkPos.containing(this.blockPosition);
                 }
diff --git a/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java b/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java
index 58b99596b16e1dd8b0c9bcde5d465c6df52cc28b..1749d107946c4a6fb50033a64a113a5f8c6cf044 100755
--- a/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java
+++ b/net/minecraft/world/entity/vehicle/boat/AbstractChestBoat.java
@@ -142,6 +142,7 @@ public abstract class AbstractChestBoat extends AbstractBoat implements HasCusto
 
     @Override
     public void setChanged() {
+        net.paperstream.world.HopperSleep.entityMoved(this.level(), this.blockPosition()); // PaperStream - Hopper wecken
     }
 
     @Override
diff --git a/net/minecraft/world/entity/vehicle/minecart/AbstractMinecartContainer.java b/net/minecraft/world/entity/vehicle/minecart/AbstractMinecartContainer.java
index 91d699adfbfa211db85734a6406d690aed5f0324..6e3d802bfc0e4009475aeb695faa4cf688b8efbb 100755
--- a/net/minecraft/world/entity/vehicle/minecart/AbstractMinecartContainer.java
+++ b/net/minecraft/world/entity/vehicle/minecart/AbstractMinecartContainer.java
@@ -66,6 +66,7 @@ public abstract class AbstractMinecartContainer extends AbstractMinecart impleme
 
     @Override
     public void setChanged() {
+        net.paperstream.world.HopperSleep.entityMoved(this.level(), this.blockPosition()); // PaperStream - Hopper wecken
     }
 
     @Override
diff --git a/net/minecraft/world/level/block/HopperBlock.java b/net/minecraft/world/level/block/HopperBlock.java
index e032b5289abe413009fe7c9068e71e788fab512a..8977d7880106f9fc1eec7d84de31026426867b9a 100755
--- a/net/minecraft/world/level/block/HopperBlock.java
+++ b/net/minecraft/world/level/block/HopperBlock.java
@@ -117,6 +117,7 @@ public class HopperBlock extends BaseEntityBlock {
     protected void neighborChanged(
         final BlockState state, final Level level, final BlockPos pos, final Block block, final @Nullable Orientation orientation, final boolean movedByPiston
     ) {
+        net.paperstream.world.HopperSleep.blockEntityChanged(level, pos); // PaperStream - Hopper wecken
         this.checkPoweredState(level, pos, state);
     }
 
diff --git a/net/minecraft/world/level/block/entity/BlockEntity.java b/net/minecraft/world/level/block/entity/BlockEntity.java
index 2c9fb60cae8065b1cd70d6ec53122cec9cf7f2a7..706e6e5446235fee22f701e700803e333f87a3c9 100755
--- a/net/minecraft/world/level/block/entity/BlockEntity.java
+++ b/net/minecraft/world/level/block/entity/BlockEntity.java
@@ -222,6 +222,7 @@ public abstract class BlockEntity implements DebugValueSource, TypedInstance<Blo
 
     protected static void setChanged(final Level level, final BlockPos worldPosition, final BlockState blockState) {
         level.blockEntityChanged(worldPosition);
+        net.paperstream.world.HopperSleep.blockEntityChanged(level, worldPosition); // PaperStream - Hopper wecken
         if (!blockState.isAir()) {
             level.updateNeighbourForOutputSignal(worldPosition, blockState.getBlock());
         }
diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index ce6b64e00a0a13ebdceda56d975d79f60c26b86d..f7f7287094d1114ea1452567018f96b664f9f0c7 100755
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -36,6 +36,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     private static final Component DEFAULT_NAME = Component.translatable("container.hopper");
     private NonNullList<ItemStack> items = NonNullList.withSize(5, ItemStack.EMPTY);
     public int cooldownTime = -1;
+    public long paperstreamSleepUntil; // PaperStream - schlafender Hopper
     private long tickedGameTime;
     private Direction facing;
 
@@ -106,12 +107,14 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
 
     @Override
     public ItemStack removeItem(final int slot, final int count) {
+        this.paperstreamSleepUntil = 0L; // PaperStream
         this.unpackLootTable(null);
         return ContainerHelper.removeItem(this.getItems(), slot, count);
     }
 
     @Override
     public void setItem(final int slot, final ItemStack itemStack) {
+        this.paperstreamSleepUntil = 0L; // PaperStream
         this.unpackLootTable(null);
         this.getItems().set(slot, itemStack);
         itemStack.limitSize(this.getMaxStackSize(itemStack));
@@ -131,10 +134,16 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
     public static void pushItemsTick(final Level level, final BlockPos pos, final BlockState state, final HopperBlockEntity entity) {
         entity.cooldownTime--;
         entity.tickedGameTime = level.getGameTime();
+        if (entity.paperstreamSleepUntil > entity.tickedGameTime) {
+            return; // PaperStream - schlafender Hopper
+        }
         if (!entity.isOnCooldown()) {
             entity.setCooldown(0);
             // Spigot start
             boolean result = tryMoveItems(level, pos, state, entity, () -> suckInItems(level, entity));
+            if (!result) {
+                net.paperstream.world.HopperSleep.sleep(entity, entity.tickedGameTime); // PaperStream
+            }
             if (!result && entity.level.spigotConfig.hopperCheck > 1) {
                 entity.setCooldown(entity.level.spigotConfig.hopperCheck);
             }
