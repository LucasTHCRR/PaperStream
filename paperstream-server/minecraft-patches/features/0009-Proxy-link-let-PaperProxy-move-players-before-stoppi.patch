From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucas@empireblocks.de>
Date: Mon, 19 Oct 2026 06:55:47 +0200
Subject: [PATCH] Proxy link: let PaperProxy move players before stopping


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 0b4ed54c6b3cb07af2bce40622bd8074ce01b34b..7d856420168f41217c840064043454b7382de287 100755
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1045,6 +1045,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             this.cancelRecordingMetrics();
         }
 
+        net.paperstream.link.ProxyLink.beforeShutdown(this); // PaperStream - let the proxy move players away first
         LOGGER.info("Stopping server");
         Commands.COMMAND_SENDING_POOL.shutdownNow(); // Paper - Perf: Async command map building; Shutdown and don't bother finishing
         // CraftBukkit start
