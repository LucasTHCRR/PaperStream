From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucasthcr@users.noreply.codeberg.org>
Date: Mon, 19 Oct 2026 05:01:43 +0200
Subject: [PATCH] Cone loading for fast players


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 04144daf262f1397471fd83a2cb7642c3b1e6833..25d023817be7fe468b890c62b24ef56793bf8ff8 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -979,6 +979,7 @@ public final class RegionizedPlayerChunkLoader {
 
                     // PaperStream - did the player turn far enough to re-sort the queues?
                     && !this.psPrefetch.shouldResort()
+                    && !this.psPrefetch.coneStateChanged() // PaperStream - cone loading switched on or off
             ) {
                 // nothing we care about changed, so we're not re-calculating
                 return;
@@ -1055,7 +1056,8 @@ public final class RegionizedPlayerChunkLoader {
                         break;
                     }
                     case CHUNK_TICKET_STAGE_LOADED: {
-                        if (canGenerateChunks || this.isLoadedChunkGeneratable(chunkX, chunkZ)) {
+                        if ((canGenerateChunks || this.isLoadedChunkGeneratable(chunkX, chunkZ))
+                            && this.psPrefetch.allowGeneration(dx, dz, ((ChunkSystemLevel)this.world).moonrise$getAnyChunkIfLoaded(chunkX, chunkZ))) { // PaperStream - cone loading
                             this.genQueue.enqueue(chunk);
                         }
                         break;
