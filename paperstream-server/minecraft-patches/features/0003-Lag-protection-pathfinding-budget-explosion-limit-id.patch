From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucasthcr@users.noreply.codeberg.org>
Date: Wed, 14 Oct 2026 00:02:26 +0200
Subject: [PATCH] Lag protection, pathfinding budget, explosion limit, idle
 mode, generation boost


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 6c5f69f2a693e97665f3d8b477f8ca7ffebb7d15..a7c00b11c4cbf504452d41e67c786ca604df9902 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -631,6 +631,7 @@ public final class RegionizedPlayerChunkLoader {
             } else if (configLimit < 0L) {
                 configLimit = Integer.MAX_VALUE;
             } // else: use the value configured
+            configLimit = (long)(configLimit * this.psPrefetch.generationBoost(this.world)); // PaperStream - generation boost for fast players
             configLimit = configLimit - this.generatingQueue.size();
 
             return configLimit;
diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 452fdd607fff12eb292559e02d1ff9f31b563f2a..28a741e30a3c79fbdd966e9053d6916d268bba57 100755
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1811,7 +1811,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.updateEffectiveRespawnData();
 
         this.isIteratingOverLevels = true; // Paper - Throw exception on world create while being ticked
+        net.paperstream.world.IdleMode.update(this); // PaperStream - idle mode
         for (ServerLevel level : this.getAllLevels()) {
+            if (!net.paperstream.world.IdleMode.shouldTickWorlds()) continue; // PaperStream - idle mode
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
             level.updateLagCompensationTick(); // Paper - lag compensation
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index 075e294333115738b25b64a390df323276cf39f9..722e4fefbde994fec1f133794945846e7ec1c9a8 100755
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -614,7 +614,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             this.level.tickThunder(chunk);
         }
 
-        if (!spawningCategories.isEmpty()) {
+        if (!spawningCategories.isEmpty() && this.level.psLimits.shouldSpawnThisTick()) { // PaperStream - lag protection
             if (this.level.getWorldBorder().isWithinBounds(chunkPos)) { // Paper - rewrite chunk system
                 NaturalSpawner.spawnForChunk(this.level, chunk, spawnCookie, spawningCategories);
             }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 0bed7673d0242c35a86c553a7f324f58f079cf32..c3dfacbf9f848bf2b7576c5f77c94e7b5184583b 100755
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -184,6 +184,7 @@ import org.slf4j.Logger;
 
 public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGetter, ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel, ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemLevelReader, ca.spottedleaf.moonrise.patches.chunk_tick_iteration.ChunkTickServerLevel { // Paper - rewrite chunk system // Paper - chunk tick iteration
     public final net.paperstream.world.WorldTickTimes psTickTimes = new net.paperstream.world.WorldTickTimes(); // PaperStream - per world MSPT
+    public final net.paperstream.world.WorldLimits psLimits = new net.paperstream.world.WorldLimits(this); // PaperStream - per world budgets
     public static final BlockPos END_SPAWN_POINT = new BlockPos(100, 50, 0);
     public static final IntProvider RAIN_DELAY = UniformInt.of(12000, 180000);
     public static final IntProvider RAIN_DURATION = UniformInt.of(12000, 24000);
@@ -1964,6 +1965,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         final WeightedList<ExplosionParticleInfo> blockParticles,
         final Holder<SoundEvent> explosionSound
     ) {
+        if (!this.psLimits.tryExplode(x, z)) return; // PaperStream - explosion limit per chunk
         // CraftBukkit start
         this.explode0(source, damageSource, damageCalculator, x, y, z, r, fire, interactionType, smallExplosionParticles, largeExplosionParticles, blockParticles, explosionSound);
     }
diff --git a/net/minecraft/world/entity/ai/navigation/PathNavigation.java b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
index 862224dfc003bf02ee0d7c1d804549210d6c8ffa..27d95d26c54ad53dc8ebcaf0c28b8086d86c84c3 100755
--- a/net/minecraft/world/entity/ai/navigation/PathNavigation.java
+++ b/net/minecraft/world/entity/ai/navigation/PathNavigation.java
@@ -171,6 +171,12 @@ public abstract class PathNavigation {
             return this.path;
         }
 
+        // PaperStream start - pathfinding budget
+        if (this.level instanceof final net.minecraft.server.level.ServerLevel serverLevel && !serverLevel.psLimits.tryPath(target != null)) {
+            return null;
+        }
+        // PaperStream end - pathfinding budget
+
         // Paper start - EntityPathfindEvent
         boolean copiedSet = false;
         for (BlockPos possibleTarget : targets) {
