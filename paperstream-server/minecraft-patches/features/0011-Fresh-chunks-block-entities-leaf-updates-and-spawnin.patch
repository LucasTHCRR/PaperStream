From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucas@empireblocks.de>
Date: Wed, 21 Oct 2026 01:31:09 +0200
Subject: [PATCH] Fresh chunks: block entities, leaf updates and spawning wait
 a moment in just loaded chunks without players, mobs from disk follow the
 activation range at once


diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 33745cd09f54fc83a8bedc2e2e8e8ef60127b1b1..45436d4183640b7ba5a24c1326a367bbe5602715 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -301,7 +301,7 @@ public final class ActivationRange {
         }
         // special case always immunities
         // immunize brand-new entities, dead entities, and portal scenarios
-        if (entity.defaultActivationState || entity.tickCount < 20 * 10 || !entity.isAlive() || (entity.portalProcess != null && !entity.portalProcess.hasExpired()) || entity.portalCooldown > 0) {
+        if (entity.defaultActivationState || (entity.tickCount < 20 * 10 && !(entity.psFromDisk && net.paperstream.PaperStreamConfig.freshChunks)) || !entity.isAlive() || (entity.portalProcess != null && !entity.portalProcess.hasExpired()) || entity.portalCooldown > 0) {
             return true;
         }
         // immunize leashed entities
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index e76f6c88851cc1ec34c5acb280c6687b8a8148d5..beea980cab9ab9a4bff66263876b70e1b72bafd0 100755
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -607,7 +607,7 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
             this.level.tickThunder(chunk);
         }
 
-        if (!spawnCategories.isEmpty() && this.level.psLimits.shouldSpawnThisTick()) { // PaperStream - lag protection
+        if (!spawnCategories.isEmpty() && this.level.psLimits.shouldSpawnThisTick() && !net.paperstream.chunk.FreshChunks.isWarming(chunk)) { // PaperStream - lag protection, fresh chunk warm up
             if (this.level.getWorldBorder().isWithinBounds(pos)) { // Paper - rewrite chunk system
                 NaturalSpawner.spawnForChunk(this.level, chunk, spawnState, spawnCategories);
             }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index a0f64fa8c3387b77e8cbb3777f2dc4fa3413d865..64d21bd63ceb6421537a86d4c6c0678a99f0910a 100755
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1319,6 +1319,9 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
             // PaperStream start - redstone clock guard
             if (!this.psRedstone.allowTick(pos, block)) {
                 this.scheduleTick(pos, block, this.psRedstone.postponeDelay());
+            } else if (block instanceof net.minecraft.world.level.block.LeavesBlock && net.paperstream.PaperStreamConfig.freshChunks
+                && this.getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4) instanceof LevelChunk psChunk && net.paperstream.chunk.FreshChunks.isWarming(psChunk)) {
+                this.scheduleTick(pos, block, net.paperstream.chunk.FreshChunks.ticksLeft(psChunk)); // PaperStream - fresh chunk warm up
             } else
             // PaperStream end - redstone clock guard
             blockState.tick(this, pos, this.random);
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 3bf618f1d756bad7755a87803132bd731e7c41be..255371970792603a464a961ec697476a69c048d0 100755
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -359,6 +359,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     protected int numCollisions = 0; // Paper - Cap entity collisions
     public boolean fromNetherPortal; // Paper - Add option to nerf pigmen from nether portals
     public boolean spawnedViaMobSpawner; // Paper - Yes this name is similar to above, upstream took the better one
+    public boolean psFromDisk; // PaperStream - loaded from a chunk, not freshly spawned
     // Paper start
     public @Nullable Vec3 origin;
     public @Nullable UUID originWorld;
@@ -2757,6 +2758,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
             }
 
             spawnedViaMobSpawner = input.getBooleanOr("Paper.FromMobSpawner", false); // Restore entity's from mob spawner status
+            this.psFromDisk = true; // PaperStream - fresh chunk warm up
             fromNetherPortal = input.getBooleanOr("Paper.FromNetherPortal", false);
             input.getString("Paper.SpawnReason").ifPresent(spawnReasonName -> {
                 try {
diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index 3acc1374a7ef968d88e9f566ce7b812fb8d580af..b55b451cc25ea6b8e4e96640c274669d98055d0b 100755
--- a/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/net/minecraft/world/level/chunk/LevelChunk.java
@@ -633,9 +633,16 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
         }
     }
 
+    // PaperStream start - fresh chunk warm up
+    public int psLoadedAt = Integer.MIN_VALUE / 2;
+    public int psWarmCheckedAt = Integer.MIN_VALUE;
+    public boolean psWarmResult;
+    // PaperStream end - fresh chunk warm up
+
     // CraftBukkit start
     public void loadCallback() {
         if (this.loadedTicketLevel) { LOGGER.error("Double calling chunk load!", new Throwable()); } // Paper
+        this.psLoadedAt = net.minecraft.server.MinecraftServer.currentTick; // PaperStream - fresh chunk warm up
         // Paper start
         this.loadedTicketLevel = true;
         // Paper end
@@ -950,7 +957,7 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
         public void tick() {
             if (!this.blockEntity.isRemoved() && this.blockEntity.hasLevel()) {
                 BlockPos blockPos = this.blockEntity.getBlockPos();
-                if (LevelChunk.this.isTicking(blockPos)) {
+                if (LevelChunk.this.isTicking(blockPos) && !net.paperstream.chunk.FreshChunks.isWarming(LevelChunk.this)) { // PaperStream - fresh chunk warm up
                     try {
                         ProfilerFiller profilerFiller = Profiler.get();
                         profilerFiller.push(this::getType);
