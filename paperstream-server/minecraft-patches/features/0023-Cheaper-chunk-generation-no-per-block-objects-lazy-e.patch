diff --git a/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java b/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
index f0529d233b791e226cec469b2efebcffd02c6d58..4c54b774dab03de962f71aec6ee9c60cdc5b2ccd 100755
--- a/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
+++ b/net/minecraft/world/level/levelgen/NoiseBasedChunkGenerator.java
@@ -444,27 +444,48 @@ public final class NoiseBasedChunkGenerator extends ChunkGenerator {
         DensityVolume volume = noiseChunk.volume();
         DensitySampler.Bound finalDensity = noiseChunk.cachingSamplers().get(this.settings.value().noiseRouter().finalDensity());
 
+        final BlockState defaultBlock = this.settings.value().defaultBlock(); // PaperStream - looked up once per chunk
         try (ScopedDensityBuffer densityBuffer = finalDensity.sampleVolume(volume)) {
             for (int z = 0; z < volume.sizeZ(); z++) {
                 int blockZ = volume.blockZ(z);
 
                 for (int x = 0; x < volume.sizeX(); x++) {
                     int blockX = volume.blockX(x);
+                    // PaperStream start - a heightmap update below its column top changes nothing, so only call it when it can
+                    int oceanFloorTop = oceanFloor.getFirstAvailable(x, z);
+                    int worldSurfaceTop = worldSurface.getFirstAvailable(x, z);
+                    int lastSectionIndex = Integer.MIN_VALUE;
+                    LevelChunkSection section = null;
+                    // PaperStream end
 
                     for (int y = volume.sizeY() - 1; y >= 0; y--) {
                         int blockY = volume.blockY(y);
-                        LevelChunkSection section = chunk.getSection(chunk.getSectionIndex(blockY));
+                        // PaperStream start - section looked up once per 16 blocks
+                        final int sectionIndex = chunk.getSectionIndex(blockY);
+                        if (sectionIndex != lastSectionIndex) {
+                            lastSectionIndex = sectionIndex;
+                            section = chunk.getSection(sectionIndex);
+                        }
+                        // PaperStream end
                         float density = densityBuffer.get(volume.indexUnchecked(x, y, z));
                         BlockState state = aquifer.computeSubstance(blockX, blockY, blockZ, density);
                         if (state == null) {
-                            state = this.settings.value().defaultBlock();
+                            state = defaultBlock;
                         }
 
                         state = this.debugPreliminarySurfaceLevel(noiseChunk, blockX, blockY, blockZ, state);
                         if (state != AIR) {
                             section.setBlockState(x, SectionPos.sectionRelative(blockY), z, state, false);
-                            oceanFloor.update(x, blockY, z, state);
-                            worldSurface.update(x, blockY, z, state);
+                            // PaperStream start
+                            if (blockY > oceanFloorTop - 2) {
+                                oceanFloor.update(x, blockY, z, state);
+                                oceanFloorTop = oceanFloor.getFirstAvailable(x, z);
+                            }
+                            if (blockY > worldSurfaceTop - 2) {
+                                worldSurface.update(x, blockY, z, state);
+                                worldSurfaceTop = worldSurface.getFirstAvailable(x, z);
+                            }
+                            // PaperStream end
                             if (aquifer.shouldScheduleFluidUpdate() && !state.getFluidState().isEmpty()) {
                                 blockPos.set(blockX, blockY, blockZ);
                                 chunk.markPosForPostProcessing(blockPos);
diff --git a/net/minecraft/world/level/levelgen/PositionalRandomFactory.java b/net/minecraft/world/level/levelgen/PositionalRandomFactory.java
index 0e6ce5959bc89b023de451c5fa8c12de1696897c..f94752a6c7f08ac3820deb6ac501dfad89c8a9ed 100755
--- a/net/minecraft/world/level/levelgen/PositionalRandomFactory.java
+++ b/net/minecraft/world/level/levelgen/PositionalRandomFactory.java
@@ -20,6 +20,12 @@ public interface PositionalRandomFactory {
 
     RandomSource at(final int x, final int y, final int z);
 
+    // PaperStream start - first float of the random at a position, without creating the random
+    default float paperstream$firstFloatAt(final int x, final int y, final int z) {
+        return this.at(x, y, z).nextFloat();
+    }
+    // PaperStream end
+
     @VisibleForTesting
     void parityConfigString(StringBuilder sb);
 }
diff --git a/net/minecraft/world/level/levelgen/XoroshiroRandomSource.java b/net/minecraft/world/level/levelgen/XoroshiroRandomSource.java
index fe3f1777546504cab9c9d1fcf7d5c2efe59d100a..7c22318e5dc37e0593f40809dafc878ad097d2a2 100755
--- a/net/minecraft/world/level/levelgen/XoroshiroRandomSource.java
+++ b/net/minecraft/world/level/levelgen/XoroshiroRandomSource.java
@@ -125,6 +125,20 @@ public class XoroshiroRandomSource implements RandomSource {
             return new XoroshiroRandomSource(randomSeed, this.seedHi);
         }
 
+        // PaperStream start - same value as at(x, y, z).nextFloat(), without the three objects
+        @Override
+        public float paperstream$firstFloatAt(final int x, final int y, final int z) {
+            long s0 = Mth.getSeed(x, y, z) ^ this.seedLo;
+            long s1 = this.seedHi;
+            if ((s0 | s1) == 0L) {
+                s0 = -7046029254386353131L;
+                s1 = 7640891576956012809L;
+            }
+            final long result = Long.rotateLeft(s0 + s1, 17) + s0;
+            return (float)(result >>> 40) * 5.9604645E-8F;
+        }
+        // PaperStream end
+
         @Override
         public RandomSource fromHashOf(final String name) {
             RandomSupport.Seed128bit seed = RandomSupport.seedFromHashOf(name);
