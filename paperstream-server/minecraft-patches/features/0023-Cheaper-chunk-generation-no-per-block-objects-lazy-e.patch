From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCRR <330454039+LucasTHCRR@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:39:18 +0100
Subject: [PATCH] Cheaper chunk generation: no per block objects, lazy
 environment attributes, fewer block and heightmap lookups


diff --git a/net/minecraft/server/level/WorldGenRegion.java b/net/minecraft/server/level/WorldGenRegion.java
index 20c5ec6e8c6b297dab499aeb9294797e672b3cb2..207c516aa2be1083092dab6d27151687e94d601d 100755
--- a/net/minecraft/server/level/WorldGenRegion.java
+++ b/net/minecraft/server/level/WorldGenRegion.java
@@ -80,7 +80,7 @@ public class WorldGenRegion implements WorldGenLevel {
     private final ChunkStep generatingStep;
     private @Nullable Supplier<String> currentlyGenerating;
     private final AtomicLong subTickCount = new AtomicLong();
-    private final EnvironmentAttributeSystem environmentAttributes;
+    private @Nullable EnvironmentAttributeSystem environmentAttributes; // PaperStream - built on first use
     private final BiomeResolver uncachedBiomeResolver;
     private final int centerChunkX;
     private final int centerChunkZ;
@@ -136,7 +136,7 @@ public class WorldGenRegion implements WorldGenLevel {
         this.centerChunkX = centerPos.x();
         this.centerChunkZ = centerPos.z();
         this.writeRadius = generatingStep.blockStateWriteRadius();
-        this.environmentAttributes = EnvironmentAttributeSystem.builder().addStaticLayers(this).build();
+        // PaperStream - built on first use, most generation steps never read it
     }
 
     public boolean isOldChunkAround(final ChunkPos pos, final int range) {
@@ -637,6 +637,12 @@ public class WorldGenRegion implements WorldGenLevel {
 
     @Override
     public EnvironmentAttributeReader environmentAttributes() {
-        return this.environmentAttributes;
+        // PaperStream start - built on first use
+        EnvironmentAttributeSystem attributes = this.environmentAttributes;
+        if (attributes == null) {
+            this.environmentAttributes = attributes = EnvironmentAttributeSystem.builder().addStaticLayers(this).build();
+        }
+        return attributes;
+        // PaperStream end - built on first use
     }
 }
