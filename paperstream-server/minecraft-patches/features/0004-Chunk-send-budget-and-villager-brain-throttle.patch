Subject: [PATCH] Chunk send budget and villager brain throttle


diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
index 64ced555998a993a38fe8bc9179d5d2b29be7a17..c1fb24d6206324a667310d8e68a8d5c6c835ab27 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/player/RegionizedPlayerChunkLoader.java
@@ -833,6 +833,11 @@ public final class RegionizedPlayerChunkLoader {
             final int maxSendsThisTick = Math.min((int)this.chunkSendLimiter.takeAllocation(time, sendRate, maxSends), this.sendQueue.size());
             // we do not return sends that we took from the allocation back because we want to limit the max send rate, not target it
             for (int i = 0; i < maxSendsThisTick; ++i) {
+                // PaperStream start - main thread time budget for chunk sending
+                if (i > 0 && net.paperstream.chunk.ChunkSendBudget.exhausted()) {
+                    break;
+                }
+                // PaperStream end - main thread time budget for chunk sending
                 final long pendingSend = this.sendQueue.firstLong();
                 final int pendingSendX = CoordinateUtils.getChunkX(pendingSend);
                 final int pendingSendZ = CoordinateUtils.getChunkZ(pendingSend);
@@ -852,7 +857,9 @@ public final class RegionizedPlayerChunkLoader {
                 }
                 this.sendQueue.dequeueLong();
 
+                final long psSendStart = System.nanoTime(); // PaperStream - chunk send budget
                 this.sendChunk(pendingSendX, pendingSendZ);
+                net.paperstream.chunk.ChunkSendBudget.spent(System.nanoTime() - psSendStart); // PaperStream - chunk send budget
 
                 if (this.removed) {
                     // sendChunk may invoke plugin logic
diff --git a/net/minecraft/world/entity/npc/villager/Villager.java b/net/minecraft/world/entity/npc/villager/Villager.java
index 89844d7e804cc8a2110b694e448bc5993991bea7..98098db7415128ec1cd0ee1de8dc168f088fcfa2 100755
--- a/net/minecraft/world/entity/npc/villager/Villager.java
+++ b/net/minecraft/world/entity/npc/villager/Villager.java
@@ -94,6 +94,10 @@ import org.jspecify.annotations.Nullable;
 import org.slf4j.Logger;
 
 public class Villager extends AbstractVillager implements ReputationEventHandler, VillagerDataHolder {
+    // PaperStream start - villager brain throttle
+    public long psLastBlockPos = Long.MIN_VALUE;
+    public int psStillTicks;
+    // PaperStream end - villager brain throttle
     private static final Logger LOGGER = LogUtils.getLogger();
     private static final EntityDataAccessor<VillagerData> DATA_VILLAGER_DATA = SynchedEntityData.defineId(Villager.class, EntityDataSerializers.VILLAGER_DATA);
     public static final int BREEDING_FOOD_THRESHOLD = 12;
@@ -297,7 +301,7 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
         // Paper end - EAR 2
         ProfilerFiller profilerFiller = Profiler.get();
         profilerFiller.push("villagerBrain");
-        if (!inactive) this.getBrain().tick(level, this); // Paper - EAR 2
+        if (!inactive && net.paperstream.entity.VillagerThrottle.shouldTickBrain(this)) this.getBrain().tick(level, this); // Paper - EAR 2 // PaperStream - villager brain throttle
         profilerFiller.pop();
         if (this.assignProfessionWhenSpawned) {
             this.assignProfessionWhenSpawned = false;
