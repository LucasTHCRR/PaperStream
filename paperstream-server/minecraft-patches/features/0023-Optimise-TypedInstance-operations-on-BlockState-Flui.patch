From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucas@empireblocks.de>
Date: Thu, 5 Nov 2026 08:49:19 +0100
Subject: [PATCH] Optimise TypedInstance operations on BlockState/FluidState
 (from Moonrise b97f0af)


diff --git a/net/minecraft/world/level/block/state/BlockBehaviour.java b/net/minecraft/world/level/block/state/BlockBehaviour.java
index be0899762dc1762450b10703ebf638233139efc1..57a1400dc097a093c31ba965b4aca8a8dca498d2 100755
--- a/net/minecraft/world/level/block/state/BlockBehaviour.java
+++ b/net/minecraft/world/level/block/state/BlockBehaviour.java
@@ -551,8 +551,17 @@ public abstract class BlockBehaviour implements FeatureElement {
         }
         // Paper end - optimise collisions
 
+        // Paper start - optimise TypedInstance
+        private final Block blockOwner;
+        private final Holder.Reference<Block> reference;
+        // Paper end - optimise TypedInstance
+
         protected BlockStateBase(final Block owner, final Property<?>[] propertyKeys, final Comparable<?>[] propertyValues) {
             super(owner, propertyKeys, propertyValues);
+            // Paper start - optimise TypedInstance
+            this.blockOwner = owner;
+            this.reference = owner.builtInRegistryHolder();
+            // Paper end - optimise TypedInstance
             BlockBehaviour.Properties properties = owner.properties;
             this.lightEmission = properties.lightEmission.applyAsInt(this.asState());
             this.useShapeForLightOcclusion = owner.useShapeForLightOcclusion(this.asState());
@@ -671,13 +680,45 @@ public abstract class BlockBehaviour implements FeatureElement {
         }
 
         public Block getBlock() {
-            return this.owner;
+            return this.blockOwner; // Paper - optimise TypedInstance
         }
 
         @Override
         public Holder<Block> typeHolder() {
-            return this.getBlock().builtInRegistryHolder();
+            return this.reference; // Paper - optimise TypedInstance
+        }
+
+        // Paper start - optimise TypedInstance
+        @Override
+        public final java.util.stream.Stream<net.minecraft.tags.TagKey<Block>> tags() {
+            return this.reference.tags();
+        }
+
+        @Override
+        public final boolean is(final net.minecraft.tags.TagKey<Block> tag) {
+            return this.reference.is(tag);
+        }
+
+        @Override
+        public final boolean is(final net.minecraft.core.HolderSet<Block> set) {
+            return set.contains(this.reference);
+        }
+
+        @Override
+        public final boolean is(final Block rawType) {
+            return this.blockOwner == rawType;
+        }
+
+        @Override
+        public final boolean is(final Holder<Block> type) {
+            return this.reference == type;
+        }
+
+        @Override
+        public final boolean is(final net.minecraft.resources.ResourceKey<Block> type) {
+            return this.reference.is(type);
         }
+        // Paper end - optimise TypedInstance
 
         @Deprecated
         public boolean blocksMotion() {
diff --git a/net/minecraft/world/level/material/FluidState.java b/net/minecraft/world/level/material/FluidState.java
index c835ae31a965b92780b7130a24c63ac217980aaa..1939a49e222df7286298022900fa456958330321 100755
--- a/net/minecraft/world/level/material/FluidState.java
+++ b/net/minecraft/world/level/material/FluidState.java
@@ -45,13 +45,22 @@ public final class FluidState extends StateHolder<Fluid, FluidState> implements
     }
     // Paper end - fluid method optimisations
 
+    // Paper start - optimise TypedInstance
+    private final Fluid fluidOwner;
+    private final Holder.Reference<Fluid> reference;
+    // Paper end - optimise TypedInstance
+
     public FluidState(final Fluid owner, final Property<?>[] propertyKeys, final Comparable<?>[] propertyValues) {
         super(owner, propertyKeys, propertyValues);
+        // Paper start - optimise TypedInstance
+        this.fluidOwner = owner;
+        this.reference = owner.builtInRegistryHolder();
+        // Paper end - optimise TypedInstance
         this.isEmpty = owner.isEmpty(); // Paper - Perf: moved from isEmpty()
     }
 
     public Fluid getType() {
-        return this.owner;
+        return this.fluidOwner; // Paper - optimise TypedInstance
     }
 
     public boolean isSource() {
@@ -131,8 +140,40 @@ public final class FluidState extends StateHolder<Fluid, FluidState> implements
 
     @Override
     public Holder<Fluid> typeHolder() {
-        return this.getType().builtInRegistryHolder();
+        return this.reference; // Paper - optimise TypedInstance
+    }
+
+    // Paper start - optimise TypedInstance
+    @Override
+    public final java.util.stream.Stream<net.minecraft.tags.TagKey<Fluid>> tags() {
+        return this.reference.tags();
+    }
+
+    @Override
+    public final boolean is(final net.minecraft.tags.TagKey<Fluid> tag) {
+        return this.reference.is(tag);
+    }
+
+    @Override
+    public final boolean is(final net.minecraft.core.HolderSet<Fluid> set) {
+        return set.contains(this.reference);
+    }
+
+    @Override
+    public final boolean is(final Fluid rawType) {
+        return this.fluidOwner == rawType;
+    }
+
+    @Override
+    public final boolean is(final Holder<Fluid> type) {
+        return this.reference == type;
+    }
+
+    @Override
+    public final boolean is(final net.minecraft.resources.ResourceKey<Fluid> type) {
+        return this.reference.is(type);
     }
+    // Paper end - optimise TypedInstance
 
     public float getExplosionResistance() {
         return this.getType().getExplosionResistance();
