From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LucasTHCR <lucas@empireblocks.de>
Date: Thu, 5 Nov 2026 12:26:54 +0100
Subject: [PATCH] Use flush where leafpile 1.2 has no writeBuffer


diff --git a/net/minecraft/nbt/NbtIo.java b/net/minecraft/nbt/NbtIo.java
index a4c411730c605920e79af2b9b9b6482de542caef..2c9338402107c17d105b527965679df8a7b6af4f 100755
--- a/net/minecraft/nbt/NbtIo.java
+++ b/net/minecraft/nbt/NbtIo.java
@@ -225,7 +225,7 @@ public class NbtIo {
             }
 
             if (NBTConstants.DEBUG_READ_WRITE) {
-                toFlush.writeBuffer();
+                toFlush.flush(); // PaperStream - leafpile 1.2 hat kein writeBuffer, flush schreibt dieselben Bytes
 
                 final java.io.ByteArrayOutputStream vanillaRaw = new java.io.ByteArrayOutputStream();
                 writeTagV(tag, new DataOutputStream(vanillaRaw), name);
@@ -250,7 +250,7 @@ public class NbtIo {
         } finally {
             // maintain behaviour with DataOutput
             if (writeBuffer) {
-                toFlush.writeBuffer();
+                toFlush.flush(); // PaperStream - leafpile 1.2 hat kein writeBuffer, flush schreibt dieselben Bytes
             }
         }
     }
